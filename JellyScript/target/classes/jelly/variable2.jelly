<?xml version="1.0" encoding="utf-8"?>
<j:jelly xmlns:j="jelly:core"
  xmlns:g="glide" trim="false">
  <html>
    <body>
      <j:new className="java.util.ArrayList" var="names"/>
      <j:invoke on="${names}" method="add">
        <j:arg value="Hosny"/>
      </j:invoke>
      <j:invoke on="${names}" method="add">
        <j:arg value="Omar"/>
      </j:invoke>
      <j:invoke on="${names}" method="add">
        <j:arg value="Zizo"/>
      </j:invoke>
      <j:invoke on="${names}" method="add">
        <j:arg value="Hosny2"/>
      </j:invoke>
      
        <div class="name-container">
          <table>
            <caption>Names List</caption>
            <thead>
              <tr>
                <th>#</th>
                <th>Name</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="n" items="${names}" varStatus="status">
                <tr>
                  <td>${status.index + 1}</td>
                  <td>${n}</td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </div>
      
      <style>
        
          .name-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 40px;
          }
        
          table {
            border-collapse: collapse;
            min-width: 400px;
            font-family: Arial, Helvetica, sans-serif;
            background: #ffffff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
          }
        
          thead {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
          }
        
          th, td {
            padding: 14px 18px;
            text-align: center;
          }
        
          th {
            font-size: 16px;
          }
        
          tbody tr {
            border-bottom: 1px solid #eee;
            transition: all 0.3s ease;
          }
        
          tbody tr:nth-child(even) {
            background: #f9f9f9;
          }
        
          tbody tr:hover {
            background: #ffe5e5;
            transform: scale(1.01);
          }
        
          td {
            color: #333;
            font-size: 15px;
            font-weight: 500;
          }
        
          caption {
            caption-side: top;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 12px;
            color: #ff4b2b;
          }
      </style>


    </body>
  </html>
</j:jelly>